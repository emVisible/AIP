# 模板：网页数据抓取 → 过滤 → 邮件报表（影刀「数据抓取+报表」经典场景）
flow data_scrape_report "网页数据抓取报表"

on manual
max_actions 50

@open_page browser.navigate url="https://example.com/orders"
@scrape_table browser.extract_table row_selector="table.orders tr" columns={order_id: ".order-id", customer: ".customer", amount: ".amount"} max_rows=200
@big_orders data.filter column=amount op=">" value=1000
@report email.send to="boss@example.com" subject="大额订单日报 ({{steps.big_orders.count}} 笔)" body_type=html body="<p>今日大额订单 {{steps.big_orders.count}} 笔，详见附件系统。</p>"
