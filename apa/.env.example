# ============================================================
# APA 环境配置 —— 复制本文件为 .env 后填入真实值（.env 已 gitignore）
# 底座：DeepSeek API（LLM 决策级联 L1/L2 + VLM 视觉感知）
# ============================================================

# ---------- DeepSeek 主配置 ----------
DEEPSEEK_API_KEY=            # 必填：https://platform.deepseek.com 获取
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- LLM 决策（§7.2 L1/L2）----------
# 未设置 APA_LLM_* 时自动回退到上方 DEEPSEEK_*
APA_LLM_BASE_URL=
APA_LLM_API_KEY=
APA_LLM_MODEL=deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# ---------- VLM 视觉感知（可选，默认关闭 — 留空即可）----------
# 仅当显式构造 BrowserExecutor(vision=...) 且页面无 data-apa-id 标注时才启用。
# 需要「支持图像输入」的多模态服务端点；纯文本 LLM（如 DeepSeek Chat）不可用。
APA_VISION_BASE_URL=
APA_VISION_API_KEY=
APA_VISION_MODEL=

# ---------- Vault 主密钥（留空 = 自动生成并落盘 <vault>.key）----------
APA_VAULT_KEY=

# ---------- WS 准入令牌（可选；与 TLS 正交，见 ws_gateway.hello_token）----------
APA_WS_TOKEN=

# ---------- 其他 ----------
# VAULT_ADDR=                 # HashiCorpVaultBackend 使用
# VAULT_TOKEN=
