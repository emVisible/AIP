    "test:e5": "pnpm run build && node --test dist/test/e5-framing.test.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "ajv": "^8.17.1",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}