{
  "name": "@apa/frontend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "desktop": "electron .",
    "start": "electron .",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');try{const ep=p.dirname(require.resolve('electron/package.json'));if(!fs.existsSync(p.join(ep,'path.txt'))){fs.writeFileSync(p.join(ep,'path.txt'),'Electron.app/Contents/MacOS/Electron')}}catch(e){}\"",
    "setup": "node electron/setup.cjs",
    "dist:prep": "node electron/stage-desktop.cjs",
    "dist:dir": "pnpm build && pnpm dist:prep && electron-builder --dir",
    "dist": "pnpm build && pnpm dist:prep && electron-builder"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@xyflow/react": "^12.11.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.7"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.taptap.apa.desktop",
    "productName": "APA Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-resources/frozen/apa_server",
        "to": "apa-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    }
  }
}
