{
  "name": "@aip/protocol",
  "version": "0.1.0",
  "description": "AIP (AI Interaction Protocol) Kernel v0.1 — TypeScript SDK",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
